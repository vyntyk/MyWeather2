<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- ЗАГОЛОВОК -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⭐ Избранные города"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- ПОЛЕ ВВОДА И КНОПКА ДОБАВЛЕНИЯ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/et_city_input"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:hint="Название города"
            android:inputType="text"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:padding="12dp"
            android:textColor="@color/black"
            android:textColorHint="@android:color/darker_gray"
            android:textSize="16sp"
            android:background="@drawable/border_edit_text"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_city"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:backgroundTint="#3E538F"
            android:text="✓"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            app:cornerRadius="25dp" />
    </LinearLayout>

    <!-- СПИСОК ИЗБРАННЫХ ГОРОДОВ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ваши города:"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_favorite_cities"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F5F5F5"
        android:elevation="2dp" />

    <!-- ПУСТОЙ СПИСОК -->
    <TextView
        android:id="@+id/tv_empty_cities"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Нет сохранённых городов.\nДобавьте город для быстрого доступа!"
        android:textAlignment="center"
        android:textColor="@android:color/darker_gray"
        android:textSize="16sp"
        android:gravity="center"
        android:visibility="gone" />

</LinearLayout>
